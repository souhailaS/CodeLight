{
  "name": "codelight",
  "displayName": "CodeLight",
  "description": "Shared highlights and inline comments that live in .vscode",
  "version": "0.5.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "media/icon.png",
  "publisher": "souhailaserbout",
  "homepage": "https://souhailas.github.io/CodeLight/",
  "repository": {
    "type": "git",
    "url": "https://github.com/souhailaS/CodeLight.git"
  },
  "bugs": {
    "url": "https://github.com/souhailaS/CodeLight/issues"
  },
  "qna": "https://github.com/souhailaS/CodeLight/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "annotations",
    "highlight",
    "comments",
    "notes",
    "code review",
    "collaboration",
    "markers",
    "reading"
  ],
  "galleryBanner": {
    "color": "#161a24",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.vscode/codelight.json",
    "workspaceContains:.vscode/codelight.json.gz"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codelight.showStatus",
        "title": "Show Status",
        "category": "CodeLight"
      },
      {
        "command": "codelight.signIn",
        "title": "Sign in with GitHub",
        "category": "CodeLight"
      },
      {
        "command": "codelight.addHighlight",
        "title": "Highlight Selection",
        "category": "CodeLight"
      },
      {
        "command": "codelight.removeHighlight",
        "title": "Remove Highlight",
        "category": "CodeLight"
      },
      {
        "command": "codelight.changeColor",
        "title": "Change Highlight Color",
        "category": "CodeLight"
      },
      {
        "command": "codelight.removeOrphaned",
        "title": "Remove Orphaned Highlights",
        "category": "CodeLight"
      },
      {
        "command": "codelight.addComment",
        "title": "Comment on Selection",
        "category": "CodeLight",
        "icon": {
          "light": "media/note-light.svg",
          "dark": "media/note-dark.svg"
        }
      },
      {
        "command": "codelight.reply",
        "title": "Reply to Highlight",
        "category": "CodeLight"
      },
      {
        "command": "codelight.editComment",
        "title": "Edit Comment",
        "category": "CodeLight"
      },
      {
        "command": "codelight.deleteComment",
        "title": "Delete Comment",
        "category": "CodeLight"
      },
      {
        "command": "codelight.showPanel",
        "title": "Show Annotations",
        "category": "CodeLight",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codelight.revealAnnotation",
        "title": "Reveal Highlight",
        "category": "CodeLight"
      },
      {
        "command": "codelight.deleteAnnotation",
        "title": "Delete Highlight",
        "category": "CodeLight",
        "icon": "$(trash)"
      },
      {
        "command": "codelight.deleteFileHighlights",
        "title": "Delete All Highlights in File",
        "category": "CodeLight",
        "icon": "$(trash)"
      },
      {
        "command": "codelight.filterByColor",
        "title": "Filter by Color",
        "category": "CodeLight",
        "icon": "$(filter)"
      },
      {
        "command": "codelight.clearFilter",
        "title": "Clear Filter",
        "category": "CodeLight",
        "icon": "$(filter-filled)"
      },
      {
        "command": "codelight.keepPrivate",
        "title": "Keep the Notes Out of Git",
        "category": "CodeLight"
      },
      {
        "command": "codelight.shareInGit",
        "title": "Let the Notes Go Into Git",
        "category": "CodeLight"
      },
      {
        "command": "codelight.convertStorage",
        "title": "Convert Annotation Storage Format",
        "category": "CodeLight"
      },
      {
        "command": "codelight.deleteOrphansEverywhere",
        "title": "Delete All Orphaned Highlights",
        "category": "CodeLight",
        "icon": "$(clear-all)"
      },
      {
        "command": "codelight.threadReply",
        "title": "Comment",
        "category": "CodeLight"
      },
      {
        "command": "codelight.threadEdit",
        "title": "Edit",
        "category": "CodeLight",
        "icon": "$(edit)"
      },
      {
        "command": "codelight.threadSave",
        "title": "Save",
        "category": "CodeLight"
      },
      {
        "command": "codelight.threadCancel",
        "title": "Cancel",
        "category": "CodeLight"
      },
      {
        "command": "codelight.threadDelete",
        "title": "Delete",
        "category": "CodeLight",
        "icon": "$(trash)"
      },
      {
        "command": "codelight.threadDiscard",
        "title": "Close",
        "category": "CodeLight",
        "icon": "$(close)"
      },
      {
        "command": "codelight.threadHighlightOnly",
        "title": "Highlight Without Comment",
        "category": "CodeLight",
        "icon": "$(symbol-color)"
      },
      {
        "command": "codelight.threadDeleteHighlight",
        "title": "Delete Highlight",
        "category": "CodeLight",
        "icon": "$(trash)"
      },
      {
        "command": "codelight.markerOn",
        "title": "Toggle Marker",
        "category": "CodeLight",
        "icon": {
          "light": "media/mark-light.svg",
          "dark": "media/mark-dark.svg"
        }
      },
      {
        "command": "codelight.markerOff",
        "title": "Turn Off Marker",
        "category": "CodeLight",
        "icon": {
          "light": "media/marker-on-light.svg",
          "dark": "media/marker-on-dark.svg"
        }
      },
      {
        "command": "codelight.openWalkthrough",
        "title": "Open Walkthrough",
        "category": "CodeLight"
      },
      {
        "command": "codelight.toggleVisibility",
        "title": "Show or Hide All Notes",
        "category": "CodeLight",
        "icon": {
          "light": "media/eye-light.svg",
          "dark": "media/eye-dark.svg"
        }
      },
      {
        "command": "codelight.showAgain",
        "title": "Show All Notes",
        "category": "CodeLight",
        "icon": {
          "light": "media/eye-off-light.svg",
          "dark": "media/eye-off-dark.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "codelight.addHighlight",
        "key": "ctrl+k ctrl+h",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "codelight.addComment",
        "key": "ctrl+k ctrl+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codelight.reply",
          "when": "false"
        },
        {
          "command": "codelight.revealAnnotation",
          "when": "false"
        },
        {
          "command": "codelight.deleteFileHighlights",
          "when": "false"
        },
        {
          "command": "codelight.clearFilter",
          "when": "codelight.filtered"
        },
        {
          "command": "codelight.deleteAnnotation",
          "when": "false"
        },
        {
          "command": "codelight.threadReply",
          "when": "false"
        },
        {
          "command": "codelight.threadEdit",
          "when": "false"
        },
        {
          "command": "codelight.threadSave",
          "when": "false"
        },
        {
          "command": "codelight.threadCancel",
          "when": "false"
        },
        {
          "command": "codelight.threadDelete",
          "when": "false"
        },
        {
          "command": "codelight.threadDiscard",
          "when": "false"
        },
        {
          "command": "codelight.threadHighlightOnly",
          "when": "false"
        },
        {
          "command": "codelight.threadDeleteHighlight",
          "when": "false"
        },
        {
          "command": "codelight.markerOff",
          "when": "false"
        },
        {
          "command": "codelight.showAgain",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "codelight.addHighlight",
          "group": "codelight@1",
          "when": "editorTextFocus"
        },
        {
          "command": "codelight.addComment",
          "group": "codelight@2",
          "when": "editorTextFocus"
        },
        {
          "command": "codelight.removeHighlight",
          "group": "codelight@3",
          "when": "editorTextFocus"
        }
      ],
      "editor/title": [
        {
          "command": "codelight.markerOn",
          "group": "navigation@7",
          "when": "resourceLangId && !codelight.marker"
        },
        {
          "command": "codelight.markerOff",
          "group": "navigation@7",
          "when": "resourceLangId && codelight.marker"
        },
        {
          "command": "codelight.addComment",
          "group": "navigation@8",
          "when": "resourceLangId"
        },
        {
          "command": "codelight.toggleVisibility",
          "group": "navigation@9",
          "when": "resourceLangId && !codelight.hidden"
        },
        {
          "command": "codelight.showAgain",
          "group": "navigation@9",
          "when": "resourceLangId && codelight.hidden"
        }
      ],
      "view/title": [
        {
          "command": "codelight.filterByColor",
          "when": "view == codelight.annotations && !codelight.filtered",
          "group": "navigation@1"
        },
        {
          "command": "codelight.clearFilter",
          "when": "view == codelight.annotations && codelight.filtered",
          "group": "navigation@1"
        },
        {
          "command": "codelight.deleteOrphansEverywhere",
          "when": "view == codelight.annotations",
          "group": "1_cleanup"
        }
      ],
      "view/item/context": [
        {
          "command": "codelight.reply",
          "when": "view == codelight.annotations && viewItem == codelight.annotation",
          "group": "inline@1"
        },
        {
          "command": "codelight.deleteAnnotation",
          "when": "view == codelight.annotations && viewItem =~ /codelight.(annotation|orphan)/",
          "group": "inline@2"
        },
        {
          "command": "codelight.deleteFileHighlights",
          "when": "view == codelight.annotations && viewItem == codelight.file",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "codelight.threadReply",
          "group": "inline",
          "when": "commentController == codelight"
        },
        {
          "command": "codelight.threadHighlightOnly",
          "group": "inline@2",
          "when": "commentController == codelight && commentThread == draft"
        },
        {
          "command": "codelight.threadDiscard",
          "group": "inline@3",
          "when": "commentController == codelight"
        }
      ],
      "comments/comment/title": [
        {
          "command": "codelight.threadEdit",
          "group": "group@1",
          "when": "commentController == codelight && comment == mine"
        },
        {
          "command": "codelight.threadDelete",
          "group": "group@2",
          "when": "commentController == codelight && comment == mine"
        }
      ],
      "comments/comment/context": [
        {
          "command": "codelight.threadCancel",
          "group": "inline@1",
          "when": "commentController == codelight"
        },
        {
          "command": "codelight.threadSave",
          "group": "inline@2",
          "when": "commentController == codelight"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "codelight.threadDeleteHighlight",
          "group": "inline@2",
          "when": "commentController == codelight && commentThread == saved"
        }
      ]
    },
    "colors": [
      {
        "id": "codelight.yellow",
        "description": "CodeLight yellow highlight",
        "defaults": {
          "light": "#ffd54f",
          "dark": "#ffd54f",
          "highContrast": "#ffd54f"
        }
      },
      {
        "id": "codelight.green",
        "description": "CodeLight green highlight",
        "defaults": {
          "light": "#81c784",
          "dark": "#81c784",
          "highContrast": "#81c784"
        }
      },
      {
        "id": "codelight.blue",
        "description": "CodeLight blue highlight",
        "defaults": {
          "light": "#64b5f6",
          "dark": "#64b5f6",
          "highContrast": "#64b5f6"
        }
      },
      {
        "id": "codelight.purple",
        "description": "CodeLight purple highlight",
        "defaults": {
          "light": "#ba68c8",
          "dark": "#ba68c8",
          "highContrast": "#ba68c8"
        }
      },
      {
        "id": "codelight.pink",
        "description": "CodeLight pink highlight",
        "defaults": {
          "light": "#f06292",
          "dark": "#f06292",
          "highContrast": "#f06292"
        }
      },
      {
        "id": "codelight.orange",
        "description": "CodeLight orange highlight",
        "defaults": {
          "light": "#ffb74d",
          "dark": "#ffb74d",
          "highContrast": "#ffb74d"
        }
      }
    ],
    "configuration": {
      "title": "CodeLight",
      "properties": {
        "codelight.palette": {
          "scope": "resource",
          "type": "array",
          "default": [],
          "markdownDescription": "Highlight colors offered in the picker. Leave empty to use the built in palette.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "hex"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        },
        "codelight.inlineComments": {
          "scope": "resource",
          "type": "string",
          "default": "preview",
          "enum": [
            "off",
            "count",
            "preview"
          ],
          "enumDescriptions": [
            "Show nothing after a commented highlight",
            "Show the number of comments",
            "Show the latest comment"
          ],
          "description": "What to show inline after a highlight that has comments."
        },
        "codelight.highlightOpacity": {
          "scope": "resource",
          "type": "number",
          "default": 0.3,
          "minimum": 0.05,
          "maximum": 1,
          "description": "Opacity of the highlight background."
        },
        "codelight.commentGutter": {
          "type": "string",
          "default": "always",
          "enum": [
            "always",
            "highlights",
            "off"
          ],
          "enumDescriptions": [
            "Offer it on every line",
            "Offer the comment button only on lines that already have a highlight",
            "Never offer it"
          ],
          "description": "Where the comment button appears in the gutter.",
          "scope": "resource"
        },
        "codelight.gutterMarks": {
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Show a coloured mark in the gutter beside every highlight."
        },
        "codelight.storage": {
          "type": "string",
          "default": "json",
          "scope": "resource",
          "enum": [
            "json",
            "compressed"
          ],
          "enumDescriptions": [
            "Create .vscode/codelight.json, a text file git can diff and merge",
            "Create .vscode/codelight.json.gz, a smaller binary file git cannot diff or merge"
          ],
          "description": "Format used only when CodeLight creates an annotation file that does not exist yet. An existing file keeps its own format until you run the command Convert Annotation Storage Format."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codelight",
          "title": "CodeLight",
          "icon": "media/codelight.svg"
        }
      ]
    },
    "views": {
      "codelight": [
        {
          "id": "codelight.annotations",
          "name": "Annotations",
          "icon": "media/codelight.svg",
          "initialSize": 1
        },
        {
          "id": "codelight.fileComments",
          "name": "This File",
          "type": "webview",
          "icon": "media/codelight.svg",
          "initialSize": 1
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "codelight.start",
        "title": "Start with CodeLight",
        "description": "Highlights and comments that live beside your code instead of inside it.",
        "steps": [
          {
            "id": "codelight.step.highlight",
            "title": "Highlight what matters",
            "description": "Select some text, then run [Highlight Selection](command:codelight.addHighlight) and pick a colour.",
            "media": {
              "markdown": "media/walkthrough/highlight.md",
              "altText": "Highlighting a selection"
            },
            "completionEvents": [
              "onCommand:codelight.addHighlight"
            ]
          },
          {
            "id": "codelight.step.comment",
            "title": "Say what you noticed",
            "description": "Put the cursor in a highlight and run [Comment on Selection](command:codelight.addComment) to open a thread.",
            "media": {
              "markdown": "media/walkthrough/comment.md",
              "altText": "Commenting on a highlight"
            },
            "completionEvents": [
              "onCommand:codelight.addComment"
            ]
          },
          {
            "id": "codelight.step.panel",
            "title": "Find every note",
            "description": "Open the [CodeLight panel](command:codelight.showPanel) to browse, filter and jump to any note.",
            "media": {
              "markdown": "media/walkthrough/panel.md",
              "altText": "The CodeLight panel"
            },
            "completionEvents": [
              "onCommand:codelight.showPanel"
            ]
          },
          {
            "id": "codelight.step.share",
            "title": "Share it, or keep it",
            "description": "Commit `.vscode/codelight.json` to share your notes, or gitignore it to keep them private.",
            "media": {
              "markdown": "media/walkthrough/share.md",
              "altText": "Sharing through git"
            }
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "codelight.annotations",
        "contents": "No notes in this project yet.\n\nSelect some code and highlight it, then add a comment to start a thread.\n\n[Highlight Selection](command:codelight.addHighlight)\n\n[Open the walkthrough](command:codelight.openWalkthrough)",
        "when": "workbenchState != empty && !codelight.filtered"
      },
      {
        "view": "codelight.annotations",
        "contents": "Open a folder to keep notes with your code. CodeLight stores them in .vscode inside the folder you open.\n\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/build.mjs && node --test out/test",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5"
  }
}
